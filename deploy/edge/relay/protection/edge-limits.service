[Unit]
Description=Per-visitor connection limits on the edge relay web ports
After=network-pre.target
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/atlantis/edge-limits.nft
# Only on a relay that takes reports from the platform server (the leading - skips a missing file).
ExecStart=-/usr/sbin/nft -f /etc/atlantis/edge-report-guard.nft
ExecStop=/usr/sbin/nft delete table inet atlantis_edge
ExecStop=-/usr/sbin/nft delete table inet atlantis_edge_report

[Install]
WantedBy=multi-user.target
