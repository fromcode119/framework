# Copy to .env and fill in. Keep it at mode 600. Never commit it.
# Generate each secret with:  openssl rand -base64 48 | tr -d '=+/' | cut -c1-48

# --- Database -----------------------------------------------------------------------------------
# THREE roles, and the separation is load-bearing. The postgres image creates POSTGRES_USER as a
# SUPERUSER; that is unavoidable, so it is spent exactly once at boot to create the other two and is
# never given to an application. A superuser bypasses row-level security entirely — connect the app
# as one and tenant isolation becomes decorative while everything still looks healthy.
POSTGRES_USER=fromcode
POSTGRES_PASSWORD=
POSTGRES_DB=fromcode

DATABASE_BOOTSTRAP_URL=postgres://fromcode:<POSTGRES_PASSWORD>@db:5432/fromcode
DATABASE_MIGRATION_URL=postgres://fromcode_owner:<OWNER_PASSWORD>@db:5432/fromcode
DATABASE_URL=postgres://fromcode_app:<APP_PASSWORD>@db:5432/fromcode

REDIS_URL=redis://redis:6379

# --- Secrets (32+ chars each, unique per deployment) --------------------------------------------
JWT_SECRET=
INTEGRATION_SECRET_KEY=
INTERNAL_SERVICE_SECRET=

# --- Public URLs --------------------------------------------------------------------------------
# What browsers use. Must match the hostnames your proxy terminates TLS for.
API_URL=https://api.example.com
ADMIN_URL=https://admin.example.com
FRONTEND_URL=https://example.com

# --- Optional -----------------------------------------------------------------------------------
# Empty disables marketplace lookups. Plugin and theme updates come from their own repositories.
MARKETPLACE_URL=

STORAGE_DRIVER=local
GUEST_EGRESS_POLICY=deny
STOREFRONT_DOCUMENT_ISLANDS=false

# Only used by the `single-domain` profile, where the bundled gateway is the ingress. If something
# else already holds port 80 on the host — Traefik, nginx, Caddy — either set this to a free port or
# leave the profile off entirely and route to api/admin/frontend directly.
GATEWAY_PORT=80

# The EXISTING external docker network your reverse proxy is on; the app services join it so the
# proxy can reach them. Same variable the dev compose and README use — one name for one concept.
# Required, with no default: guessing an ingress network is worse than refusing to start.
#   plain Traefik   EXTERNAL_PROXY_NETWORK=edge
#   Coolify         EXTERNAL_PROXY_NETWORK=${COOLIFY_RESOURCE_UUID}
EXTERNAL_PROXY_NETWORK=edge
