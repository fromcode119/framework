# Every variable `site-refresh.sh --site <name>` requires, and what each one is.
#
# Copy to <platform-root>/scripts/site-refresh.d/<name>.conf and fill in. That directory is OUTSIDE
# this repository deliberately, for the same reason `deploy/targets.json` is: the values name hosts,
# container ids and database users of somebody's production box. The procedure is shareable; the
# addresses are not.

# The LIVE single-tenant deployment being copied FROM. Nothing is ever written here — the only
# statement issued against it is `pg_dump`, and its uploads are read with `tar -c`.
SOURCE_HOST="root-example-source"
SOURCE_DB_CONTAINER="db-xxxxxxxxxxxx"
SOURCE_API_CONTAINER=""              # optional; only the `secrets` stage needs it
SOURCE_DB_USER="postgres"
SOURCE_DB_NAME="example"

# The PLATFORM being copied TO.
TARGET_HOST="root-example-platform"
TARGET_DEPLOY_DIR="/opt/apps/platform/framework/deploy"

# Staging area on the TARGET. The snapshot is streamed straight through and never lands on the
# source box, which is usually the one short of disk.
WORK_DIR="/opt/apps/platform/migration/example"
SCRATCH_DB="example_scratch"

# The site as it will exist on the platform.
SITE_SLUG="example"

# Short key for the temporary paths this refresh creates on the target
# (<key>-uploads, <key>-archive.tar.gz).
SITE_KEY="ex"

# THE STAGING HOST, not the live one. The archive's host is what the imported tenant CLAIMS, and the
# platform must not claim the live name while it still serves the real site from the old box — a
# private tenant REFUSES the public, so claiming it early would replace the real site with that
# refusal the moment DNS moved. The live host is introduced deliberately at cutover, never by a
# refresh.
SITE_HOST="example.platform.example.com"
SITE_ALIAS=""
