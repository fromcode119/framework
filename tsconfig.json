{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      // `@ai/*` is the ai package's PRIVATE alias for its own source. typor-build resolves it to a
      // relative path before tsc runs, so nothing reaches dist — see AliasEmitRewrite.
      "@ai/*": [
        "packages/ai/src/*"
      ],
      // Every other typor-built package carries the same kind of PRIVATE alias for its own source,
      // resolved to a relative path by AliasEmitRewrite before tsc emits. NOT declared for archor /
      // reactor / nextor / typor: those build with raw `tsc` (no typor-build wrapper), so an alias
      // would survive verbatim into their dist and Node could not resolve it.
      "@core/*": ["packages/core/src/*"],
      "@database/*": ["packages/database/src/*"],
      "@react/*": ["packages/react/src/*"],
      "@api/*": ["packages/api/src/*"],
      "@auth/*": ["packages/auth/src/*"],
      "@cache/*": ["packages/cache/src/*"],
      "@marketplace-client/*": ["packages/marketplace-client/src/*"],
      "@media/*": ["packages/media/src/*"],
      "@email/*": ["packages/email/src/*"],
      "@scheduler/*": ["packages/scheduler/src/*"],
      "@plugins/*": ["packages/plugins/src/*"],
      "@mcp/*": ["packages/mcp/src/*"],
      "@sdk/*": ["packages/sdk/src/*"],
      "@nextjs/*": ["packages/next/src/*"],
      "@cli/*": ["packages/cli/src/*"],
      
      "@fromcode119/core": ["packages/core/src"],
      "@fromcode119/core/client": ["packages/core/src/client.ts"],
      "@fromcode119/core/*": ["packages/core/src/*"],
      "@fromcode119/ai": ["packages/ai/src"],
      "@fromcode119/database": ["packages/database/src"],
      "@fromcode119/database/*": ["packages/database/src/*"],
      "@fromcode119/sdk": ["packages/sdk/src"],
      "@fromcode119/sdk/*": ["packages/sdk/src/*"],
      "@fromcode119/auth": ["packages/auth/src"],
      "@fromcode119/media": ["packages/media/src"],
      "@fromcode119/react": ["packages/react/src"],
      "@fromcode119/email": ["packages/email/src"],
      "@fromcode119/cache": ["packages/cache/src"],
      "@fromcode119/scheduler": ["packages/scheduler/src"],
      "@fromcode119/plugins": ["packages/plugins/src"],
      "@fromcode119/mcp": ["packages/mcp/src"],
      "@fromcode119/marketplace-client": ["packages/marketplace-client/src"]
    },
    "composite": true,
    "jsx": "react-jsx",
    "noImplicitAny": false
  },
  "files": [],
  "references": [
    { "path": "./packages/ai" },
    { "path": "./packages/core" },
    { "path": "./packages/sdk" },
    { "path": "./packages/react" },
    { "path": "./packages/next" },
    { "path": "./packages/cli" },
    { "path": "./packages/api" },
    { "path": "./packages/database" },
    { "path": "./packages/auth" },
    { "path": "./packages/media" },
    { "path": "./packages/email" },
    { "path": "./packages/cache" },
    { "path": "./packages/mcp" },
    { "path": "./packages/scheduler" },
    { "path": "./packages/plugins" },
    { "path": "./packages/marketplace-client" }
  ],
  "exclude": ["node_modules", "dist", "packages/admin", "packages/frontend"]
}
