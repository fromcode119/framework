# =============================================================================
# Fromcode — Environment Configuration
# Copy this file to .env and edit as needed.  No other env files are required.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# Default: PostgreSQL, in every environment (local included) — per-site isolation is a row-level
# security policy the database enforces, and SQLite has no equivalent. Three roles, on purpose:
#   POSTGRES_USER          owns the database (compose creates it) — the app must NEVER connect as it
#   <owner role>           owns the schema and runs migrations
#   <app role>             the plain role DATABASE_URL connects as — only a plain role gets RLS
# ---------------------------------------------------------------------------
DB_DIALECT=postgres
DATABASE_URL=postgresql://CHANGE_ME_APP_ROLE:CHANGE_ME_APP_PASSWORD@localhost:5432/fromcode
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=fromcode

# SQLite is supported for SINGLE-site installs only (no row-level security, so no multi-site mode):
# DB_DIALECT=sqlite
# DATABASE_URL=file:./data/app.db

# ---------------------------------------------------------------------------
# Ports
# Bind ports for the three local processes.
# These are not duplicates: API, Admin, and Frontend each run their own server.
# ---------------------------------------------------------------------------
PORT=3000
ADMIN_PORT=3001
FRONTEND_PORT=3002

# Public browser URLs for each surface.
# Use these when the surfaces are on different origins (e.g. admin.example.com,
# www.example.com). In local single-origin proxy setups they may all collapse to
# one host, but the runtime still treats them as separate surfaces.
ADMIN_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002

# Shared secret the api presents when it calls the admin or frontend directly, server to server —
# today the Settings -> Infrastructure restart buttons. NEVER a browser credential. The SAME value
# must reach all three services. Leave it unset and those endpoints reject every call, so the admin
# shows the admin/frontend restart buttons as unavailable rather than failing on click.
INTERNAL_SERVICE_SECRET=

# Where the api reaches the other two apps from INSIDE the deployment network. Optional: falls back
# to ADMIN_URL / FRONTEND_URL. In Docker these are the service names.
INTERNAL_ADMIN_URL=
INTERNAL_FRONTEND_URL=
ALLOWED_DEV_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---------------------------------------------------------------------------
# System
# ---------------------------------------------------------------------------
NODE_ENV=development
API_VERSION_PREFIX=v1
DEFAULT_LOCALE=en

# Browser-facing API origin.
# Next.js client bundles can only read NEXT_PUBLIC_* variables.
# In local dev this often matches API_URL; in Docker/production it is usually
# the public API host while API_URL may be an internal service address.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_AI_ENABLED=false

# Server-to-server API origin (SSR, internal fetches, container-to-container calls).
# In Docker: use the service name, e.g. http://api:3000
# In local dev: use the public proxy or direct API host, e.g. http://localhost:3000
API_URL=http://localhost:3000

CORS_ALLOWED_DOMAINS=localhost
COOKIE_DOMAIN=.framework.local

# ---------------------------------------------------------------------------
# Redis
# Leave blank to use in-memory cache (fine for local dev, not for production)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./public/uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads

# ---------------------------------------------------------------------------
# Email
# Leave EMAIL_PROVIDER=mock to log emails to console instead of sending them
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Plugins & Themes
# These paths are relative to FROMCODE_PROJECT_ROOT (defaults to cwd)
# ---------------------------------------------------------------------------
PLUGINS_DIR=./plugins
THEMES_DIR=./themes
MARKETPLACE_URL=http://marketplace.framework.local

# Reverse proxy network used by Docker Compose / Traefik setups
EXTERNAL_PROXY_NETWORK=proxy

# Use one routing mode at a time:
# 1. Subdomain mode: admin.example.com, api.example.com, www.example.com
#    Leave NEXT_PUBLIC_ADMIN_BASE_PATH empty/unset.
# 2. Same-domain mode behind a gateway/proxy: example.com/admin
#    Set NEXT_PUBLIC_ADMIN_BASE_PATH=/admin in that deployment only.
# 3. Multi-site: the platform gateway is the ONE upstream the proxy forwards every hostname to. It
#    routes by host from the site table (storefront hosts → frontend, workspace hosts → admin,
#    api. aliases → api, unknown host → 404). Needs INTERNAL_SERVICE_SECRET above.

# ---------------------------------------------------------------------------
# Platform gateway (multi-site)
# ---------------------------------------------------------------------------
# Host port the gateway listens on (compose).
GATEWAY_PORT=80
# Where the api pushes a routing reload when a site is created, changed or removed.
GATEWAY_INTERNAL_URL=http://gateway:3000
# How long the gateway keeps its routing map before refreshing; it keeps the last map if the api is down.
GATEWAY_ROUTING_TTL_MS=30000
# The gateway's upstreams (compose service names).
API_TARGET_URL=http://api:3000
ADMIN_TARGET_URL=http://admin:3000
FRONTEND_TARGET_URL=http://frontend:3000

# ---------------------------------------------------------------------------
# Admin appearances
# ---------------------------------------------------------------------------
# Installed admin appearances — product consoles (appearance/<slug>/appearance.json).
APPEARANCE_DIR=./appearance
# Deployment default appearance: set only on a standalone product install (a single-site deployment
# that IS a workspace, e.g. ADMIN_APPEARANCE=nexora). Multi-site deployments set it per site instead.
ADMIN_APPEARANCE=

# ---------------------------------------------------------------------------
# Security / Rate Limiting
# ---------------------------------------------------------------------------

# Security
# Replace before exposing the app outside local development.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
INTEGRATION_SECRET_KEY=CHANGE_ME_INTEGRATION_SECRET_MIN_32_CHARS
INTEGRATION_SECRET_MASK=__FROMCODE_SAVED_SECRET__

# ---------------------------------------------------------------------------
# HTML -> PDF renderer (opt-in sidecar)
# ---------------------------------------------------------------------------
# A headless-Chromium service (browserless) used by plugins that print PDFs — today only the
# numerology booklet export. It is NOT in the api image: the browser and its system libraries were
# ~977MB that every install paid for and almost none used.
#
# Add deploy/docker-compose.pdf.yml to your compose command to run it — that file is the ONE
# definition of the service, so it is never copied into the per-mode compose files. Then point the
# plugin at it in admin (Numerology -> Settings -> PDF renderer URL):
#   ws://pdf-renderer:3000/chromium/playwright?token=<PDF_RENDERER_TOKEN>
# Leave the setting empty and booklet exports fall back to the built-in PDFKit layout.
PDF_RENDERER_TOKEN=
PDF_RENDERER_CONCURRENT=2
PDF_RENDERER_TIMEOUT=60000
