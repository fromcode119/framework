# Gzipped build artifacts
*.js.gz

# Build output produced by build-plugins.sh — never commit.
# `ui/frontend.js` is the storefront bundle and `ui-ssr/` its server twin; both are regenerated on
# every pack, so committing them makes each build show up as a spurious diff.
ui/frontend.js
ui/frontend.js.map
ui-ssr/

# Compiled admin-UI stylesheet (build-plugins.sh -> build_plugin_ui_styles).
# Tailwind output for this plugin's own src/ui components, shipped in the tarball so the
# admin can style them at runtime. A build artifact like bundle.js — never committed.
src/ui/style.css
ui/style.css
