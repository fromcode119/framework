{
  "name": "@fromcode119/core",
  "version": "0.2.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js",
      "require": "./dist/constants/*.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js",
      "require": "./dist/process/index.js"
    }
  },
  "browser": {
    "./src/hooks/hook-adapter-factory.ts": "./src/hooks/hook-adapter-factory.browser.ts",
    "fs": false,
    "path": false,
    "os": false,
    "crypto": false,
    "stream": false,
    "http": false,
    "https": false,
    "net": false,
    "tls": false,
    "dns": false,
    "zlib": false,
    "child_process": false,
    "adm-zip": false,
    "chokidar": false,
    "tar": false,
    "async_hooks": false,
    "events": false,
    "ioredis": false,
    "bull": false,
    "better-sqlite3": false,
    "pg": false,
    "mysql2": false,
    "archiver": false,
    "zip-stream": false
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../typescript-multiple-inheritance/dist/tsmi-cli.cjs build && npm run copy:templates",
    "dev": "tsc -w",
    "test": "vitest run --config ../../vitest.plugins.config.ts --project core",
    "copy:templates": "mkdir -p dist/plugin/services/templates && cp -r src/plugin/services/templates/. dist/plugin/services/templates/",
    "prepack": "npm run copy:templates"
  },
  "dependencies": {
    "@fromcode119/cache": "*",
    "@fromcode119/database": "*",
    "@fromcode119/email": "*",
    "@fromcode119/marketplace-client": "*",
    "@fromcode119/mcp": "*",
    "@fromcode119/media": "*",
    "@fromcode119/plugins": "*",
    "@fromcode119/react-class-components": "*",
    "@fromcode119/scheduler": "*",
    "@fromcode119/typescript-multiple-inheritance": "*",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "chokidar": "^3.6.0",
    "drizzle-orm": "^0.45.1",
    "handlebars": "^4.7.9",
    "ioredis": "^5.9.2",
    "semver": "^7.6.0",
    "tar": "^7.5.7",
    "ws": "^8.19.0",
    "zod": "^3.22.4",
    "@fromcode119/queue": "*"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/ioredis": "^4.28.10",
    "@types/semver": "^7.5.0",
    "@types/tar": "^6.1.13",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
