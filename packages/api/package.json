{
  "name": "@fromcode119/api",
  "version": "0.2.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fromcode-api": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "copy:templates": "mkdir -p dist/controllers/auth/email-templates/templates && cp -r src/controllers/auth/email-templates/templates/. dist/controllers/auth/email-templates/templates/ && mkdir -p dist/utils/templates && cp -r src/utils/templates/. dist/utils/templates/ && mkdir -p dist/controllers/system/templates && cp -r src/controllers/system/templates/. dist/controllers/system/templates/",
    "build": "node ../typescript-multiple-inheritance/dist/tsmi-cli.cjs build && npm run copy:templates",
    "prepack": "npm run copy:templates",
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/server.ts",
    "start": "node dist/bin.js",
    "test": "vitest run --config ../../vitest.plugins.config.ts --project api"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@fromcode119/admin": "*",
    "@fromcode119/auth": "*",
    "@fromcode119/core": "*",
    "@fromcode119/database": "*",
    "@fromcode119/extension-builder": "*",
    "@fromcode119/frontend": "*",
    "@fromcode119/mcp-server": "*",
    "@fromcode119/media": "*",
    "@fromcode119/scheduler": "*",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "graphql": "^16.12.0",
    "graphql-http": "^1.22.4",
    "handlebars": "^4.7.9",
    "multer": "^2.0.0-alpha.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/adm-zip": "^0.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^25.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3"
  }
}
