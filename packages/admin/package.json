{
  "name": "@fromcode119/admin",
  "version": "0.1.88",
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "bin": {
    "fromcode-admin": "scripts/admin.js"
  },
  "files": [
    ".next",
    "public",
    "scripts",
    "app",
    "components",
    "lib",
    "service-worker",
    "next.config.*",
    "tailwind.config.*",
    "postcss.config.*",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build:sw": "node ../typescript-multiple-inheritance/dist/tsmi-cli.cjs esbuild service-worker/service-worker.ts --bundle --format=iife --global-name=AdminServiceWorkerModule --target=es2020 --tsconfig=tsconfig.json \"--footer:js=AdminServiceWorkerModule.AdminServiceWorker.register();\" --outfile=public/sw.js",
    "typecheck:sw": "tsc --noEmit -p service-worker/tsconfig.json",
    "build": "npm run build:sw && node ../next-build-codegen/dist/next-build-codegen-cli.cjs with-middleware -- next build",
    "prepack": "npm run build:sw",
    "dev": "node ../next-build-codegen/dist/next-build-codegen-cli.cjs with-middleware -- next dev --webpack -H 0.0.0.0",
    "start": "node ../core/dist/process/app-launcher-main.js --app admin --hostname 0.0.0.0",
    "test": "vitest run --config ../../vitest.plugins.config.ts --project admin --project admin-dom"
  },
  "dependencies": {
    "@fromcode119/core": "*",
    "@fromcode119/react": "*",
    "@fromcode119/react-class-components": "*",
    "@fromcode119/sdk": "*",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "0.56.0",
    "@types/node": "^22.10.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "drizzle-orm": "^0.45.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "pg": "^8.17.2",
    "postcss": "^8.5.6",
    "react": "19.0.0",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@vitejs/plugin-react": "^5.1.3",
    "esbuild": "^0.27.2",
    "jsdom": "^28.0.0",
    "vitest": "^4.1.11"
  }
}
