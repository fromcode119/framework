{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "ES2020",
      "WebWorker"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fromcode119/core/*": [
        "../core/src/*"
      ],
      "@fromcode119/core": [
        "../core/src/client.ts"
      ]
    }
  },
  "include": [
    "service-worker.ts",
    "../lib/pwa/admin-service-worker-constants.ts"
  ]
}
