{
  "name": "@fromcode119/frontend",
  "version": "0.2.5",
  "bin": {
    "fromcode-frontend": "scripts/frontend.js"
  },
  "files": [
    ".next",
    "public",
    "scripts",
    "app",
    "components",
    "lib",
    "next.config.*",
    "tailwind.config.*",
    "postcss.config.*",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "node ../next-build-codegen/dist/next-build-codegen-cli.cjs with-middleware -- next dev --webpack -H 0.0.0.0",
    "build": "node ../next-build-codegen/dist/next-build-codegen-cli.cjs with-middleware -- next build",
    "start": "node ../core/dist/process/app-launcher-main.js --app frontend --hostname 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run --config ../../vitest.plugins.config.ts --project frontend"
  },
  "dependencies": {
    "@fromcode119/core": "*",
    "@fromcode119/react": "*",
    "@fromcode119/sdk": "*",
    "@types/node": "^22.10.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.23",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.563.0",
    "next": "16.3.4",
    "postcss": "^8.5.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3"
  }
}
