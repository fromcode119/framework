{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      // A package tsconfig REPLACES the inherited `paths` map rather than merging into it, so every
      // private package alias this app compiles through must be repeated here.
      "@core/*": ["../core/src/*"],
      "@database/*": ["../database/src/*"],
      "@react/*": ["../react/src/*"],
      "@api/*": ["../api/src/*"],
      "@auth/*": ["../auth/src/*"],
      "@cache/*": ["../cache/src/*"],
      "@marketplace-client/*": ["../marketplace-client/src/*"],
      "@media/*": ["../media/src/*"],
      "@email/*": ["../email/src/*"],
      "@scheduler/*": ["../scheduler/src/*"],
      "@plugins/*": ["../plugins/src/*"],
      "@mcp/*": ["../mcp/src/*"],
      "@sdk/*": ["../sdk/src/*"],
      "@nextjs/*": ["../next/src/*"],
      "@cli/*": ["../cli/src/*"],
      "@/*": [
        "../admin/*"
      ],
      // `@/*` above pulls admin sources into this compile, and the admin's middleware graph imports
      // reactor's React-FREE subpath. Mapped to the BUILT declaration, not to reactor's src: this
      // workspace compiles with `moduleResolution: node`, which ignores a package's `exports` map, and
      // mapping the source would drag reactor's files under this project's rootDir.
      "@fromcode119/react-class-components/lang": [
        "../react-class-components/dist/lang.d.ts"
      ],
      "@fromcode119/core": [
        "../core/src"
      ],
      "@fromcode119/core/client": [
        "../core/src/client.ts"
      ],
      "@fromcode119/core/*": [
        "../core/src/*"
      ],
      "@fromcode119/database": [
        "../database/src"
      ],
      "@fromcode119/database/*": [
        "../database/src/*"
      ],
      "@fromcode119/plugins": [
        "../plugins/src"
      ],
      "@fromcode119/plugins/*": [
        "../plugins/src/*"
      ],
      "@fromcode119/sdk": [
        "./src/index.ts"
      ],
      "@fromcode119/sdk/*": [
        "./src/*"
      ],
      "@fromcode119/react": [
        "./src/react/react-shim.d.ts"
      ],
      "@fromcode119/admin/components": [
        "./src/admin/admin-components-shim.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../database"
    },
    {
      "path": "../core"
    },
    {
      "path": "../marketplace-client"
    },
    {
      "path": "../mcp"
    }
  ],
  "exclude": [
    "src/vite/**"
  ]
}
