{
  "name": "@fromcode119/create",
  "version": "0.2.5",
  "description": "Create a new Fromcode app",
  "bin": {
    "create-atlantis": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "npm run build:index && npm run build:proxy",
    "build:index": "../../node_modules/.bin/esbuild src/create-app.ts --bundle --format=cjs --platform=node --charset=utf8 --tsconfig-raw='{\"compilerOptions\":{\"experimentalDecorators\":true,\"useDefineForClassFields\":false}}' --outfile=dist/index.js",
    "build:proxy": "../../node_modules/.bin/esbuild src/proxy.ts --bundle --external:http-proxy --format=cjs --platform=node --charset=utf8 --tsconfig-raw='{\"compilerOptions\":{\"experimentalDecorators\":true,\"useDefineForClassFields\":false}}' --outfile=template/proxy.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "fromcode",
    "create",
    "scaffolder",
    "cms"
  ],
  "license": "MIT"
}
