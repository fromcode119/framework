{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "useDefineForClassFields": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ],
  "references": [
    {
      "path": "../react"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../mcp"
    },
    {
      "path": "../core"
    },
    {
      "path": "../database"
    },
    {
      "path": "../auth"
    }
  ],
  "exclude": [
    "**/tests/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
