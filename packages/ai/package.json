  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.16",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
