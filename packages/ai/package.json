{
  "name": "@fromcode119/ai",
  "version": "0.2.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts"
    },
    "./runtime": {
      "import": "./dist/admin-assistant-runtime.js",
      "require": "./dist/admin-assistant-runtime.js",
      "types": "./dist/admin-assistant-runtime.d.ts",
      "development": "./src/admin-assistant-runtime.ts"
    },
    "./admin": {
      "import": "./dist/admin-extension.js",
      "require": "./dist/admin-extension.js",
      "types": "./dist/admin-extension.d.ts",
      "development": "./src/admin-extension.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../typescript-multiple-inheritance/dist/tsmi-cli.cjs build && node ../next-build-codegen/dist/next-build-codegen-cli.cjs stamp-client dist",
    "dev": "tsc -w",
    "test": "vitest run --config ../../vitest.plugins.config.ts packages/ai"
  },
  "dependencies": {
    "@fromcode119/mcp": "*",
    "@fromcode119/react": "*",
    "@fromcode119/react-class-components": "*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@fromcode119/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
